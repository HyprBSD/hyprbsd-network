// SPDX-License-Identifier: BSD-2-Clause
// hyprbsd-network's root helper: wheel members in an active local session turn
// Wi-Fi and network cards on or off without a password, and set up Wi-Fi, a
// card's addresses or a lagg after an administrator's password (kept a few
// minutes); nobody else.
polkit.addRule(function(action, subject) {
	var switches = ["org.hyprbsd.network.wifi", "org.hyprbsd.network.iface-switch"];
	var settings = ["org.hyprbsd.network.setup", "org.hyprbsd.network.iface", "org.hyprbsd.network.lagg"];
	var isSwitch = switches.indexOf(action.id) >= 0;
	if (!isSwitch && settings.indexOf(action.id) < 0)
		return polkit.Result.NOT_HANDLED;
	if (!(subject.local && subject.active && subject.isInGroup("wheel")))
		return polkit.Result.NO;
	return isSwitch ? polkit.Result.YES : polkit.Result.AUTH_ADMIN_KEEP;
});
